	column Year-Quarter
		lineageTag: bce895a5-ad26-4908-8bb8-99a52f4782c4
		isNameInferred
		sourceColumn: [Year-Quarter]

	partition Date = calculated
		mode: import
		source =
				VAR MinDate = DATE(2013, 1, 1)
				VAR MaxDate = DATE(2015, 12, 31)
				RETURN
				ADDCOLUMNS(
				    CALENDAR(MinDate, MaxDate),
				    "Year", YEAR([Date]),
				    "Quarter", "Q" & ROUNDUP(MONTH([Date])/3, 0),
				    "Month Number", MONTH([Date]),
				    "Month Name", FORMAT([Date], "mmmm"),
				    "Day Name", FORMAT([Date], "dddd"),
				    "Day of Month", DAY([Date]),
				    "Week Number", WEEKNUM([Date]),
				    "Year-Month", FORMAT([Date], "yyyy-mm"),
				    "Year-Quarter", FORMAT([Date], "yyyy") & "-" & "Q" & ROUNDUP(MONTH([Date])/3, 0)
				)

